# Single root .env for the whole workspace — apps/web, apps/api, apps/worker,
# and libs/uptime-db all load THIS ONE FILE (not a per-app .env). See
# CLAUDE.md's Environment Setup section.
#
# Ports are intentionally NOT set here: apps/api defaults to 4001 and
# apps/worker defaults to 4002 in their own code (`process.env.PORT ?? ...`)
# — since both would read the same PORT var from this shared file, setting
# it here would make them collide. apps/web's port is fixed in its own
# `next dev -p 4000` script. Leave PORT unset unless you're running a single
# app in isolation and need to override its default.

# --- Database (libs/uptime-db, apps/api, apps/worker) ---
DATABASE_URL=postgresql://user:password@localhost:5432/uptime_db

# --- Redis / BullMQ (apps/api, apps/worker) ---
REDIS_URL=redis://localhost:6379

# --- Shared secret between apps/web and apps/api (must match) ---
INTERNAL_API_KEY=

# --- apps/web / NextAuth ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:4000
API_URL=http://localhost:4001
NEXT_PUBLIC_API_URL=http://localhost:4001

# --- apps/worker: Signal alerting (signal-cli-rest-api sidecar) ---
SIGNAL_REST_API_URL=http://localhost:8080

# --- apps/worker: email alerting (SMTP relay) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@yourdomain.com

# --- apps/worker: Bull Board (mounted at /admin/queues, Basic Auth) ---
BULL_BOARD_USER=
BULL_BOARD_PASS=

# --- libs/uptime-db seed script (npm run uptime:seed) ---
# This is the one bootstrap "Super Admin" account (immutable via the Users
# CRUD UI/API — see User.isProtected) — its login is ADMIN_USERNAME, its
# displayed name is ADMIN_NAME. Every other user is created from /users.
ADMIN_USERNAME=superadmin
ADMIN_NAME=Super Admin
ADMIN_PASSWORD=
