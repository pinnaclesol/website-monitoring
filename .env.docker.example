# docker-compose.dev.yml loads both `.env` and `.env.docker` (in that
# order), so only these two values need overriding here — everything else
# (NEXTAUTH_SECRET, INTERNAL_API_KEY, etc.) still comes from your existing
# `.env`, no duplication. Your native `npm run dev` is unaffected — it never
# reads this file.
#
# `postgres`/`redis` below are the Docker Compose SERVICE NAMES from
# docker-compose.dev.yml (its own containers, not anything on your machine)
# — Docker's built-in DNS resolves them, no install/setup needed.

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/uptime_db
REDIS_URL=redis://redis:6379
