# docker-compose.dev.yml loads both `.env` and `.env.docker` (in that
# order), so only these two values need overriding here — everything else
# (NEXTAUTH_SECRET, INTERNAL_API_KEY, etc.) still comes from your existing
# `.env`, no duplication. Your native `npm run dev` is unaffected — it never
# reads this file.

DATABASE_URL=postgresql://postgres:your-password@host.docker.internal:5432/uptime_db
REDIS_URL=redis://default:your-password@host.docker.internal:6379
