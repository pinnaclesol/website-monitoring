{
  "name": "uptime-monitor",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,worker -c blue,green,magenta \"npm:dev:web\" \"npm:serve:api\" \"npm:serve:worker\"",
    "dev:web": "nx dev web",
    "serve:api": "nx serve api",
    "serve:worker": "nx serve worker",
    "build": "nx run-many --target=build --all",
    "lint": "nx run-many --target=lint --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "test": "jest",
    "uptime:generate": "npm run --prefix libs/uptime-db generate",
    "uptime:migrate": "npm run --prefix libs/uptime-db migrate",
    "uptime:studio": "npm run --prefix libs/uptime-db studio",
    "uptime:seed": "npm run --prefix libs/uptime-db seed",
    "postinstall": "npm run uptime:generate"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/node": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.0.0",
    "dotenv": "^16.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^30.5.2",
    "nx": "23.2.1",
    "prettier": "^3.0.0",
    "ts-jest": "^29.4.13",
    "tslib": "^2.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  },
  "dependencies": {
    "@bull-board/api": "9.10.1",
    "@bull-board/express": "9.10.1",
    "@bull-board/nestjs": "9.10.1",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.4",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nx/next": "23.2.1",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "1.1.21",
    "@tailwindcss/postcss": "4.3.3",
    "bcryptjs": "3.0.3",
    "bullmq": "6.3.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "6.0.0",
    "libphonenumber-js": "^1.11.1",
    "next": "16.3.5",
    "next-auth": "4.24.15",
    "nodemailer": "10.0.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "nodemailer": "10.0.10"
  }
}
