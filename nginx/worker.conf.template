server {
    listen 80 default_server;
    server_name _;

    # 127.0.0.11 is Docker's embedded DNS. `worker`'s container is
    # recreated (new IP) on every scripts/redeploy.sh run, but this nginx
    # container itself isn't restarted then — a plain
    # `proxy_pass http://worker:4002` would resolve once at config-load
    # and go stale after the first redeploy. A variable forces nginx to
    # re-resolve per the `valid` window instead of caching forever.
    resolver 127.0.0.11 valid=10s;

    # Bull Board (/admin/queues) and /health both live on the same
    # worker:4002 NestJS app — no separate routing needed, Bull Board
    # gates itself with BULL_BOARD_USER/PASS internally.
    location / {
        set $upstream_worker http://worker:4002;
        proxy_pass $upstream_worker;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
