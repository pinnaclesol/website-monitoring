# Single combined server (api + web + worker). Copy to `.env.prod` and
# fill in real values — never committed (see .gitignore). Loaded by all
# three app services in docker-compose.prod.yml.
#
# No DOMAIN/CERTBOT_EMAIL here — this server currently runs plain HTTP,
# no TLS (see nginx/prod.conf.template's header comment). Add those back
# if/when this needs Let's Encrypt again.

# DATABASE_URL: copy straight from your DigitalOcean Managed Postgres
# dashboard's "Connection Details" — it already includes `?sslmode=require`,
# which Prisma reads natively from the URL (no code change needed). Read
# by `api` (CRUD) and `worker` (writes MonitorCheck/Incident rows).
DATABASE_URL=postgresql://doadmin:PASSWORD@your-postgres-cluster-host:25060/uptime_db?sslmode=require

# DigitalOcean Managed Redis/Valkey's connection string, copied straight
# from its dashboard. Use the `rediss://` (TLS) scheme it gives you, not a
# plain `redis://` — ioredis (which BullMQ/libs/queue use under the hood)
# detects `rediss://` and enables TLS automatically; no code change needed.
# Read by `api` (BullMQ producer) and `worker` (BullMQ consumer).
REDIS_URL=rediss://default:PASSWORD@your-redis-cluster-host:25061

# Shared secret between `web` and `api` — generate with:
#   openssl rand -hex 32
INTERNAL_API_KEY=

# NextAuth session secret — generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# The real public URL this server will be reachable at — plain http:// for
# now (see header comment above); switch to https:// only once TLS is
# re-added.
NEXTAUTH_URL=http://your-domain-or-ip

# Only needed if this server also runs the signal-cli-rest-api sidecar
# (see the commented-out service in docker-compose.prod.yml) — if you're
# not using Signal alerts, or the sidecar runs elsewhere, leave as-is.
SIGNAL_REST_API_URL=http://signal-cli-rest-api:8080

# Gates /admin/queues (Bull Board) — pick your own values.
BULL_BOARD_USER=
BULL_BOARD_PASS=

# Loopback inside THIS server is wrong here — api and web are separate
# containers, not the same one. `web`'s actual API_URL is set directly in
# docker-compose.prod.yml (http://api:4001, the compose service name),
# not here — left unset in this file on purpose.
