# Unified single-server production environment variables.
# Copy this file to `.env.production` on your server:
#   cp .env.prod.example .env.production
# Never commit `.env.production` to git.

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/uptime_db?sslmode=require

# --- Redis / BullMQ ---
# Use rediss:// for SSL/TLS connections (e.g. DigitalOcean managed Redis)
REDIS_URL=rediss://default:password@your-redis-host:25061

# --- Shared internal API key between web and api ---
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# The public URL your dashboard will be accessed from
NEXTAUTH_URL=http://your-server-ip-or-domain

# --- Internal Docker endpoints ---
API_URL=http://api:4001
SIGNAL_REST_API_URL=http://signal-bridge:8080
SIGNAL_DEVICE_NAME=UptimeMonitor

# --- Bull Board Queue Dashboard (/admin/queues) ---
BULL_BOARD_USER=admin
BULL_BOARD_PASS=

# --- Bootstrap Super Admin (seeded if running npm run uptime:seed) ---
ADMIN_USERNAME=superadmin
ADMIN_NAME=Super Admin
ADMIN_PASSWORD=
