// libs/uptime-db/prisma/schema.prisma
//
// Single shared Prisma schema for the uptime-monitor app. Both apps/api and
// apps/worker talk to this one dedicated Postgres database through the
// UptimePrismaService/UptimePrismaModule exported from @uptime/uptime-db —
// neither app owns its own prisma/ folder or client.
//
// Plain PascalCase model/table names: this Postgres instance is fully
// dedicated to this app, so there's no need for a shared-DB disambiguation
// prefix the way billing-manager uses `Rebil_`. Names are deliberately
// self-descriptive (`Monitor`, `MonitorCheck`, `MonitorAlertState`,
// `AlertSettings`, `BrandingSettings`) rather than generic (`Site`, `Check`,
// `AlertState`, `NotificationSettings`, `AppSettings`) — a dev browsing the
// table list or the generated Prisma Client should be able to tell what
// each one is for without cross-referencing this file.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// No sign-up route — the first user is seeded via `npm run uptime:seed`,
/// further users are created from the `/users` view. Fixed 3-role RBAC
/// (ADMIN/EDITOR/VIEWER) — see `@uptime/auth`'s `hasPermission`. `role:
/// ADMIN` is an implicit super-admin for *permissions* (bypasses every
/// `hasPermission` check). `isProtected` is a separate, narrower concept: it
/// marks the one bootstrap account (always the env-seeded user) as
/// immutable through the Users CRUD API entirely — not editable or
/// deletable by anyone, including itself — so there's always a guaranteed
/// way back in via the seed script even if every other admin is
/// locked/removed.
model User {
  id          String   @id @default(cuid())
  username    String   @unique // login handle — not shown in the UI beyond the Users list
  name        String? // display name shown in the sidebar/UI; falls back to username if unset
  password    String // bcrypt hash — never log or return in API responses
  role        Role     @default(VIEWER)
  isProtected Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("User")
}

/// Fixed set of roles driving `@uptime/auth`'s `hasPermission`. ADMIN is an
/// implicit super-admin (bypasses per-permission checks); EDITOR/VIEWER are
/// checked against an explicit permission table.
enum Role {
  ADMIN
  EDITOR
  VIEWER
}

/// A monitored URL/domain — the core entity of the app. Soft-deleted via
/// `deletedAt` so check/incident history survives removal from the
/// dashboard. Named `Monitor` (not `Site`) to match the app's own UI
/// language ("Add monitor", "Monitors" table) instead of an ambiguous word
/// that could mean anything.
model Monitor {
  id        String    @id @default(cuid())
  domain    String
  label     String?
  isPaused  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  checks     MonitorCheck[]
  incidents  Incident[]
  alertState MonitorAlertState?

  @@map("Monitor")
}

/// One health-check result performed by apps/worker for a Monitor. Capped
/// at the newest 100 rows per monitor by the daily `cleanup` BullMQ job —
/// this is an app-level housekeeping policy, not a DB constraint.
model MonitorCheck {
  id             String   @id @default(cuid())
  monitorId      String
  timestamp      DateTime @default(now())
  isUp           Boolean
  statusCode     Int?
  responseTimeMs Int?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  // Required for efficient "latest checks for a monitor" queries.
  @@index([monitorId, timestamp(sort: Desc)])
  @@map("MonitorCheck")
}

/// Downtime log for a Monitor. `endedAt = null` means the incident is
/// currently open. Invariant (app-level, not DB-enforced): at most one open
/// row (`endedAt = null`) per monitor at any time — opened on
/// down-confirmed, closed on recovery. Not enforced with a partial unique
/// index; the down/recovery state machine in apps/worker is responsible for
/// upholding this.
model Incident {
  id        String    @id @default(cuid())
  monitorId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, startedAt(sort: Desc)])
  @@map("Incident")
}

/// One row per Monitor, drives the down -> repeat-every-N -> recovery alert
/// dedup state machine. Mutated in place by apps/worker; no `updatedAt`
/// since `lastAlertSentAt` already tracks the last meaningful state change.
model MonitorAlertState {
  id              String    @id @default(cuid())
  monitorId       String    @unique
  isDown          Boolean   @default(false)
  lastAlertSentAt DateTime?

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("MonitorAlertState")
}

/// A Telegram bot/chat destination. Multiple rows = multiple destinations,
/// managed from the Settings view.
model TelegramAccount {
  id        String   @id @default(cuid())
  label     String
  botToken  String // secret — never logged or returned in API responses
  chatId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("TelegramAccount")
}

/// Signal sender/recipient pairing. Single config (not multi-account) —
/// requires a running signal-cli-rest-api sidecar with a registered phone
/// number, so this models an infra-bound integration, not just a credential.
model SignalConfig {
  id              String   @id @default(cuid())
  senderNumber    String
  recipientNumber String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("SignalConfig")
}

/// An email address that receives alert notifications, sent via one
/// env-configured SMTP relay.
model EmailRecipient {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("EmailRecipient")
}

/// Singleton row: alert-repeat/recovery behavior shared by all notification
/// channels (Telegram/Signal/Email). Modeled as a normal table — the app is
/// responsible for ever only upserting a single row; no DB-level singleton
/// enforcement (e.g. a fixed/hardcoded id) is required. Named `AlertSettings`
/// (not the more generic `NotificationSettings`) since that's precisely what
/// it holds.
model AlertSettings {
  id                   String   @id @default(cuid())
  alertIntervalSeconds Int      @default(300)
  recoveryAlertEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("AlertSettings")
}

/// Singleton row: dashboard branding. Same app-enforced-singleton pattern as
/// AlertSettings — no DB-level singleton constraint, the app only ever
/// upserts one row. Named `BrandingSettings` (not the more generic
/// `AppSettings`) to say exactly what it configures, and matches its own API
/// route (`/settings/branding`). Two independent pairs: `appName`/
/// `appLogoUrl` (in-app branding — sidebar) and `siteTitle`/`faviconUrl`
/// (browser-facing — tab title/icon). Both image fields hold a
/// `/uploads/<file>` path written by apps/web's local upload route, not a
/// pasted external URL.
model BrandingSettings {
  id         String   @id @default(cuid())
  appName    String   @default("Uptime Monitor") // sidebar product name
  appLogoUrl String? // sidebar logo mark
  siteTitle  String   @default("Uptime Monitor") // browser tab <title>
  faviconUrl String? // browser tab icon
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("BrandingSettings")
}
