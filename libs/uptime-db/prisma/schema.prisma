// libs/uptime-db/prisma/schema.prisma
//
// Single shared Prisma schema for the uptime-monitor app. Both apps/api and
// apps/worker talk to this one dedicated Postgres database through the
// UptimePrismaService/UptimePrismaModule exported from @uptime/uptime-db —
// neither app owns its own prisma/ folder or client.
//
// Plain PascalCase model/table names: this Postgres instance is fully
// dedicated to this app, so there's no need for a shared-DB disambiguation
// prefix the way billing-manager uses `Rebil_`.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single admin user. No sign-up route — seeded via `npm run uptime:seed`.
/// No roles/permissions: this app deliberately has no RBAC.
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String // bcrypt hash — never log or return in API responses
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("User")
}

/// A monitored URL/domain. Soft-deleted via `deletedAt` so check/incident
/// history survives removal from the dashboard.
model Site {
  id        String    @id @default(cuid())
  domain    String
  label     String?
  isPaused  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  checks    Check[]
  incidents Incident[]
  alertState AlertState?

  @@map("Site")
}

/// One row per check performed by apps/worker. Capped at the newest 100 rows
/// per site by the daily `cleanup` BullMQ job — this is an app-level
/// housekeeping policy, not a DB constraint.
model Check {
  id             String   @id @default(cuid())
  siteId         String
  timestamp      DateTime @default(now())
  isUp           Boolean
  statusCode     Int?
  responseTimeMs Int?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // Required for efficient "latest checks for a site" queries.
  @@index([siteId, timestamp(sort: Desc)])
  @@map("Check")
}

/// Downtime log. `endedAt = null` means the incident is currently open.
/// Invariant (app-level, not DB-enforced): at most one open row
/// (`endedAt = null`) per site at any time — opened on down-confirmed,
/// closed on recovery. Not enforced with a partial unique index; the
/// down/recovery state machine in apps/worker is responsible for upholding
/// this.
model Incident {
  id        String    @id @default(cuid())
  siteId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, startedAt(sort: Desc)])
  @@map("Incident")
}

/// One row per site, drives the down -> repeat-every-N -> recovery alert
/// dedup state machine. Mutated in place by apps/worker; no `updatedAt`
/// since `lastAlertSentAt` already tracks the last meaningful state change.
model AlertState {
  id              String    @id @default(cuid())
  siteId          String    @unique
  isDown          Boolean   @default(false)
  lastAlertSentAt DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("AlertState")
}

/// A Telegram bot/chat destination. Multiple rows = multiple destinations,
/// managed from the Notifications settings view.
model TelegramAccount {
  id        String   @id @default(cuid())
  label     String
  botToken  String // secret — never logged or returned in API responses
  chatId    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("TelegramAccount")
}

/// Signal sender/recipient pairing. Single config (not multi-account) —
/// requires a running signal-cli-rest-api sidecar with a registered phone
/// number, so this models an infra-bound integration, not just a credential.
model SignalConfig {
  id             String   @id @default(cuid())
  senderNumber   String
  recipientNumber String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("SignalConfig")
}

/// An email address that receives alert notifications, sent via one
/// env-configured SMTP relay.
model EmailRecipient {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("EmailRecipient")
}

/// Singleton row: general alert behavior settings shared by all
/// notification channels. Modeled as a normal table — the app is
/// responsible for ever only upserting a single row; no DB-level singleton
/// enforcement (e.g. a fixed/hardcoded id) is required.
model NotificationSettings {
  id                    String   @id @default(cuid())
  alertIntervalSeconds  Int      @default(300)
  recoveryAlertEnabled  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("NotificationSettings")
}
