  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '=== Uptime Monitor Monorepo ===\nApps: web(:4000) api(:4001) worker(:4002)\nDB:    libs/uptime-db/prisma/schema.prisma -> dedicated Postgres (uptime_db)\nQueue: Redis + BullMQ via libs/queue - api is PRODUCER only, worker is CONSUMER only\nUI:    libs/ui/src - design tokens only, no ad-hoc hex colors\nRun:   npm run dev\n\n! worker is the ONLY app allowed to call monitored sites directly.\n! Every Write/Edit below is auto-typechecked + linted - no need to run it by hand.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(npm run dev*)",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-env.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit -p tsconfig.base.json 2>&1 | head -20 || true"
          },
          {
            "type": "command",
            "command": "npx nx affected --target=lint --uncommitted 2>&1 | tail -30 || true"
          }
        ]
      }
    ]
  }
}
