# dependencies
node_modules/

# build outputs
dist/
.next/
out/
build/

# env files (keep examples)
*.env
!*.env.example
# .env.docker/.env.web-api/.env.worker/.env.prod each hold real credentials
# (see their matching .example files) — *.env above doesn't match any of
# them since none of these filenames end in ".env".
.env.docker
.env.web-api
.env.worker
.env.prod

# Real managed-DB/SSH credentials sometimes get jotted down here as a
# scratch note while provisioning infra — never let it become trackable.
.info.txt

# Prisma generated client
libs/uptime-db/src/generated/
libs/uptime-db/prisma/generated/

# libs/auth, libs/queue, and libs/uptime-db (outside src/generated/ above) are
# consumed as plain TS source via path aliases, never built — a stray
# `tsc`-with-emit invocation can leave compiled .js/.js.map siblings next to
# the .ts source; they're never imported by anything but are easy to miss.
libs/auth/src/**/*.js
libs/auth/src/**/*.js.map
libs/queue/src/**/*.js
libs/queue/src/**/*.js.map
libs/uptime-db/src/*.js
libs/uptime-db/src/*.js.map

# Nx
.nx/cache/
.nx/workspace-data/
nx-cloud.env

# testing
coverage/

# logs
*.log
npm-debug.log*

# TypeScript build info
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# apps/web: runtime-uploaded branding images (see app/api/upload/route.ts) —
# local disk state on the apps/web VPS, not repo content.
apps/web/public/uploads/

# misc
*.local
signal-data/
