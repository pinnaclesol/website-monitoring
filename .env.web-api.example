# Phase 2, Server 1 (api + web). Copy to `.env.web-api` and fill in real
# values — never committed (see .gitignore). Loaded by the `api` and `web`
# services in docker-compose.web-api.yml.
#
# No DOMAIN/CERTBOT_EMAIL here — this server currently runs plain HTTP, no
# TLS (see nginx/web-api.conf.template's header comment). Add those back
# if/when this needs Let's Encrypt again.
#
# DATABASE_URL: copy straight from your DigitalOcean Managed Postgres
# dashboard's "Connection Details" — it already includes `?sslmode=require`,
# which Prisma reads natively from the URL (no code change needed).
DATABASE_URL=postgresql://doadmin:PASSWORD@your-postgres-cluster-host:25060/uptime_db?sslmode=require

# `api` is the BullMQ producer (registers/removes each monitor's repeatable
# check job, enqueues manual "check now" jobs — see CLAUDE.md's Queue
# architecture section) — it needs Redis even though it's not the consumer.
# Same DigitalOcean Managed Redis/Valkey instance as .env.worker's
# REDIS_URL. Use the `rediss://` (TLS) scheme it gives you, not a plain
# `redis://` — ioredis detects `rediss://` and enables TLS automatically.
REDIS_URL=rediss://default:PASSWORD@your-redis-cluster-host:25061

# Shared secret between `web` and `api` — generate with:
#   openssl rand -hex 32
INTERNAL_API_KEY=

# NextAuth session secret — generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# The real public URL this server will be reachable at — plain http:// for
# now (see header comment above); switch to https:// only once TLS is
# re-added.
NEXTAUTH_URL=http://your-domain-or-ip

# Loopback inside THIS server is wrong here — api and web are separate
# containers, not the same one. `web`'s actual API_URL is set directly in
# docker-compose.web-api.yml (http://api:4001, the compose service name),
# not here — left unset in this file on purpose.

# Signal bridge URL (reachable from api/web server, or http://127.0.0.1:8080)
SIGNAL_REST_API_URL=http://localhost:8080
SIGNAL_DEVICE_NAME=UptimeMonitor
